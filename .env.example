# GEMINI_API_KEY: browser copy helpers only. Real AI image generation uses
# apps/api/.env GEMINI_API_KEY (never expose the live key to Vite).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Platform name matches Master Admin chrome (Souq Platform / منصة سوق).
APP_NAME="Souq Platform"
# Hostinger Cloud package. Central repo stays:
# https://github.com/hafizfahadilyas/unityteck-saas
# Flowers (store-1) has its own Hostinger. Coffee, car, and new stores share the central Hostinger.
# Subscriptions: Pro 300 SAR / month, Premium 500 SAR / month.
HOSTING_PACKAGE=hostinger_cloud
CENTRAL_GIT_REPO=https://github.com/hafizfahadilyas/unityteck-saas
COFFEE_DOMAIN_SOURCE=included_free
COFFEE_DOMAIN=mieraf-ksa.com
COFFEE_LOGIN_EMAIL=mieraf.sa8@gmail.com

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ----------------------------------------------------
# ADMIN SPA → LARAVEL API (Phase 1.4–1.5)
# Laravel: npm run api:serve  →  http://127.0.0.1:8010
# Vite proxies /api → :8010 (see vite.config.ts)
# Set VITE_USE_API=false (or omit) to keep mock-only demos.
# ----------------------------------------------------
VITE_USE_API=true
VITE_API_URL=/api

# Clerk Email OTP — Master/Store password login is DISABLED.
# SPA publishable key + API secret (apps/api/.env CLERK_SECRET_KEY) are both required.
# Dashboard: https://dashboard.clerk.com → API Keys → Email verification code
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
# Backend only (never VITE_ / never commit real secret):
# CLERK_SECRET_KEY=sk_test_xxxxx

# Same Google OAuth Client ID as apps/api GOOGLE_CLIENT_ID (public; secret stays on API only)
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# ----------------------------------------------------
# ADMIN SECURE CREDENTIALS (Override defaults)
# ----------------------------------------------------
VITE_STORE_ADMIN_EMAIL=p4pakistan098@gmail.com
VITE_STORE_ADMIN_PASSWORD=MakkahStore@2026!Secure
VITE_MASTER_ADMIN_EMAIL=master@unityteck.com
VITE_MASTER_ADMIN_PASSWORD=UnityMaster@2026!Secure
VITE_COFFEE_ADMIN_EMAIL=mieraf.sa8@gmail.com

# ----------------------------------------------------
# HOSTINGER MYSQL 8 DATABASE CONFIGURATION
# ----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=srv1422.hstgr.io
DB_PORT=3306
DB_DATABASE=u920689430_giftshop
DB_USERNAME=u920689430_giftshop
DB_PASSWORD=your_hostinger_db_password_here
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_STRICT=true
DB_ENGINE=InnoDB
MYSQL_ATTR_SSL_CA=MYSQL_ATTR_SSL_CA

# ----------------------------------------------------
# HOSTINGER FTP — one build, two accounts
# Central FTP user is locked to mieraf-ksa.com/public_html, so remote dir is /
# Flowers uses its own Hostinger. Do not commit real passwords.
# npm run deploy:all | deploy:central | deploy:flowers
# ----------------------------------------------------
FTP_CENTRAL_HOST=your_central_ftp_host
FTP_CENTRAL_USER=your_central_ftp_user
FTP_CENTRAL_PASSWORD=your_central_ftp_password
FTP_CENTRAL_DIR=/
FTP_CENTRAL_URL=https://mieraf-ksa.com/
FTP_FLOWERS_HOST=your_flowers_ftp_host
FTP_FLOWERS_USER=your_flowers_ftp_user
FTP_FLOWERS_PASSWORD=your_flowers_ftp_password
FTP_FLOWERS_DIR=/public_html
FTP_FLOWERS_URL=https://giftshop-sa.com/
# Legacy names still map to the flowers account
FTP_HOST=your_flowers_ftp_host
FTP_USER=your_flowers_ftp_user
FTP_PASSWORD=your_flowers_ftp_password
FTP_REMOTE_DIR=/public_html
FTP_TARGET_URL=https://giftshop-sa.com/

