{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3010 --host=0.0.0.0",
    "api:serve": "cd apps/api && php artisan serve --host=127.0.0.1 --port=8010",
    "build": "vite build",
    "deploy:hostinger": "vite build && node scripts/deploy-hostinger.js",
    "preview": "vite preview --port=3010",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "backup": "node scripts/backup-database.js",
    "backup:store": "node scripts/backup-database.js --scope=store",
    "restore": "node scripts/restore-database.js",
    "restore:confirm": "node scripts/restore-database.js --confirm"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "basic-ftp": "^6.2.2",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
