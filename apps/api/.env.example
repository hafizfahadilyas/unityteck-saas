APP_NAME=Unityteck
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Local API serve: php artisan serve --host=127.0.0.1 --port=8010
# (Vite proxies /api → :8010 — see root .env.example)
APP_URL=http://127.0.0.1:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------
# DATABASE
# Local: DB_CONNECTION=sqlite (touch database/database.sqlite)
# Hostinger: mysql + import database/hostinger/01_schema.sql then 02_seed.sql
# (placeholders — no real password; never commit .env)
# ----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=srv1422.hstgr.io
DB_PORT=3306
DB_DATABASE=u920689430_giftshop
DB_USERNAME=u920689430_giftshop
DB_PASSWORD=your_hostinger_db_password_here
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_STRICT=true
DB_ENGINE=InnoDB
MYSQL_ATTR_SSL_CA=

# SQLite local alternative (comment mysql block above when using):
# DB_CONNECTION=sqlite
# # DB_DATABASE left empty → apps/api/database/database.sqlite

# Vite admin SPA (CORS + Sanctum SPA domains)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

SESSION_DRIVER=database
# Minutes until idle web session expires. ~10 years — admin logout is the only end.
SESSION_LIFETIME=5256000
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Admin login OTP email (FREE path — no Clerk). Pick ONE provider:
# Hostinger mailbox SMTP:
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
# Resend free (3k/mo): MAIL_HOST=smtp.resend.com MAIL_PORT=465 MAIL_USERNAME=resend MAIL_PASSWORD=re_xxx
# Brevo free (300/day): MAIL_HOST=smtp-relay.brevo.com MAIL_PORT=587 MAIL_USERNAME=... MAIL_PASSWORD=... MAIL_ENCRYPTION=tls
# Local without SMTP: MAIL_MAILER=log (OTP shown on login screen via dev_code)

# ----------------------------------------------------
# Google Site Kit (ONE platform OAuth app — each store connects own Google)
# Cloud Console: https://console.cloud.google.com/apis/credentials
# Enable: Search Console, Indexing, Analytics Admin+Data, Tag Manager, PageSpeed
# Ads optional: Google Ads API + developer token
# Authorized redirect URIs (add BOTH local + live):
#   http://localhost:3000
#   http://127.0.0.1:3000
#   https://YOUR-ADMIN-DOMAIN.com
#   https://YOUR-API-DOMAIN.com/api/google/callback
# ----------------------------------------------------
# Must be the SAME Web client the admin UI uses (never a mismatched Advanced Client ID).
# OAuth consent screen → Testing: add each store-owner Gmail under Test users.
# Warning "Google has not confirmed ownership" = Testing / unverified — Advanced → Continue, then add Test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional: SOQU Manager customer id (digits only) when accessing client Ads accounts
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Meta WhatsApp Cloud API (platform fallback; prefer per-store WhatsApp Settings)
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=unityteck_wa_secret_verify_token_2026

# Meta Graph — Instagram / Facebook social publish (per-store Page tokens in DB)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v19.0
META_OAUTH_REDIRECT_URI=

# KSA SMS — Unifonic Cloud and/or Taqnyat (prefer per-store Notification Settings)
# https://www.unifonic.com/  ·  https://taqnyat.sa/
SMS_PROVIDER=unifonic
SMS_SENDER_ID=
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=
UNIFONIC_BASE_URL=https://el.cloud.unifonic.com
TAQNYAT_API_KEY=
TAQNYAT_SENDER_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------
# Clerk Email OTP (Master + Store admin) — REQUIRED
# Password login is disabled. After OTP, API verifies
# clerk_token via Backend API then mints Sanctum PAT.
# Never expose secret to Vite / never commit real keys.
# ----------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# ----------------------------------------------------
# Gemini AI Media (image / future video) — API only
# Never put this key in Vite. Video stays off until wired.
# ----------------------------------------------------
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# New AI Studio keys: use gemini-3.8-flash (gemini-2.5-flash returns 404 for new users).
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_VIDEO_ENABLED=false
GEMINI_VIDEO_MODEL=veo-2.0-generate-001
