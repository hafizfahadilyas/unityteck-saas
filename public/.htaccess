# Do NOT enable Hostinger LiteShield / Bot Protection "drop" mode on this file.
# Hostinger injects: LsRecaptcha + RewriteRule .* - [E=verifycaptcha:drop]
# When reCAPTCHA quota is exceeded, that block returns site-wide 403 Forbidden.
DirectoryIndex storefront-shell.php index.html

# Enable GZIP / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2 application/vnd.ms-fontobject
</IfModule>

# Browser Caching Headers
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Immutable caching for hashed assets
  <FilesMatch "\.(js|mjs|css|woff2?|png|jpe?g|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    # Tenant hosts (e.g. souq-default.mieraf-ksa.com) load Vite modules cross-origin
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
  </FilesMatch>

  # HTML must not be aggressively cached so deploys show immediately
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Admin / Master / storefront shell is PHP — never LiteSpeed / CDN cache
  # (laptop often kept old SPA while mobile showed new — HTML must always revalidate)
  <FilesMatch "^(storefront-shell|sitemap|robots|llms)\.php$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header set X-LiteSpeed-Cache-Control "no-cache"
    Header set CDN-Cache-Control "no-store"
    Header set Cloudflare-CDN-Cache-Control "no-store"
    Header set Surrogate-Control "no-store"
  </FilesMatch>
</IfModule>

# Single Page Application (SPA) Routing & HTTPS Enforcement
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Ensure HTTPS and preserve query parameters (QSA)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,QSA]

  # Redirect any legacy /public_html path to root to prevent stale asset MIME errors
  RewriteRule ^public_html(?:/(.*))?$ /$1 [R=301,L,NC]

  RewriteRule ^sitemap\.xml$ /sitemap.php [L]
  RewriteRule ^robots\.txt$ /robots.php [L]
  RewriteRule ^llms\.txt$ /llms.php [L]

  # Live Hostinger Multi-Tenant REST API Gateway
  RewriteRule ^api/(.*)$ /api/index.php [QSA,L]
  RewriteRule ^api$ /api/index.php [QSA,L]

  # Master Admin = central Hostinger ONLY (mieraf-ksa.com).
  # Flowers / store hosts must never serve /master* — bounce to central login.
  RewriteCond %{HTTP_HOST} ^(www\.)?(giftshop-sa\.com|tanjeedmakkah\.com)$ [NC]
  RewriteRule ^master(?:/.*)?$ https://mieraf-ksa.com/master/login [R=302,L,QSA]
  RewriteCond %{HTTP_HOST} ^(www\.)?(giftshop-sa\.com|tanjeedmakkah\.com)$ [NC]
  RewriteRule ^masteradmin(?:/.*)?$ https://mieraf-ksa.com/master/login [R=302,L,QSA]

  # Force SPA for auth/admin routes EVEN if a physical /admin folder exists on Hostinger.
  # Without this, /admin → directory → bounce to storefront homepage.
  RewriteRule ^admin/?$ /storefront-shell.php [L,QSA]
  RewriteRule ^admin/(.*)$ /storefront-shell.php [L,QSA]
  RewriteRule ^master/?$ /storefront-shell.php [L,QSA]
  RewriteRule ^master/(.*)$ /storefront-shell.php [L,QSA]
  RewriteRule ^store/?$ /storefront-shell.php [L,QSA]
  RewriteRule ^store/(.*)$ /storefront-shell.php [L,QSA]
  # Short onboarding share links → SPA
  RewriteRule ^join/?$ /storefront-shell.php [L,QSA]
  RewriteRule ^join/(.*)$ /storefront-shell.php [L,QSA]
  RewriteRule ^j/(.*)$ /storefront-shell.php [L,QSA]
  RewriteRule ^onboard/(.*)$ /storefront-shell.php [L,QSA]

  # Route souq.mieraf-ksa.com host to /souq directory
  RewriteCond %{HTTP_HOST} ^souq\.mieraf-ksa\.com$ [NC]
  RewriteCond %{REQUEST_URI} !^/souq(?:/|$)
  RewriteRule ^(.*)$ /souq/$1 [L]

  # Support souq static export /_next assets
  RewriteRule ^_next/(.*)$ /souq/_next/$1 [L]

  # Fallback for stale cached index bundle references (e.g., after new deployments)
  RewriteCond %{REQUEST_URI} ^/assets/index-[^/]+\.js$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/index-[^/]+\.js$ /assets/index-C0fhbuso.js [L]

  RewriteCond %{REQUEST_URI} ^/assets/index-[^/]+\.css$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/index-[^/]+\.css$ /assets/index-D5CcHLaK.css [L]

  # Prevent serving HTML for missing static assets (return 404 instead of index.html fallback)
  RewriteCond %{REQUEST_URI} !^/assets/index-
  RewriteCond %{REQUEST_URI} \.(?:js|mjs|css|png|jpe?g|gif|webp|svg|woff2?|ttf|eot|ico|json|map)$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  RewriteRule ^index\.html$ /storefront-shell.php [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /storefront-shell.php [L,QSA]
</IfModule>
